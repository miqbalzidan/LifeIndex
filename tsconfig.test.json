{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Only the tests and the build tooling run in Node; the app itself is
    // browser-only and its config deliberately does not carry these types.
    "types": ["node"]
  },
  "include": [
    "src/**/*.test.ts",
    "test",
    "e2e",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ],
  "exclude": []
}
